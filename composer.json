{
  "name": "aligent/magento2-introspection-auth",
  "description": "Restricts introspection GraphQL queries to authorised users",
  "type": "magento2-module",
  "require": {
    "php": "~8.1.0|~8.2.0|~8.3.0|~8.4.0|~8.5.0",
    "magento/framework": "*"
  },
  "license": [
    "GPL-3.0-only"
  ],
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Aligent\\IntrospectionAuth\\": ""
    }
  },
  "require-dev": {
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
